import os
import time
def clear_terminal():
    os.system('cls'if os.name=='nt'else 'clear')
class Members_Management:
    def __init__(self,first_name ,last_name,id,status='inactive'):
        self.first_name=first_name 
        self.last_name=last_name
        self.id=id
        self.status=status
    def display(self):
        print(f'First Name: {self.first_name}')
        print(f'Last Name: {self.last_name}')
        print(f'ID mentorship: {self.id}')
        print(f'Status: {self.status}')
        print('User Added Succussfully💖💘')
        print('-'*30)
found_members=[]
def search(member):
    clear_terminal()
    print('Search by:\n\n1.Membership ID\n2.First name\n3.Membership Status\n')
    choose=input('Enter your choice : ')
    found_members=[]
    if choose=='1':
        id=input('enter the ID: ')
        for i in member:
            if i.id == id:
                found_members.append(i)
                break
    elif choose=='2':
        name=input('Enter first name: ')
        for i in member:
            if i.first_name==name.lower():
                found_members.append(i)
    elif choose=='3':
        status=input('Enter status(active/inactive): ').strip()
        for i in member:
            if i.status.strip().lower()==status:
                found_members.append(i)
    if found_members:
        clear_terminal()
        print("member's found")
        for i in found_members:
            i.display()
    else:
        print('Member not found')

def ask_user():
    first_name=input('Enter first name: ')
    last_name=input('Enter last name: ')
    id =input('Enter ID: ')
    status=input('Enter status ,or click enter to skip: ')
    if not status:
        status='inactive'
    return Members_Management(first_name,last_name,id,status)
member=[]
while True:
    print('Welcome to Member management.\n')
    choose=input('choose an Action\n1.Add new member\n2.Display all members\n3.Search for a member\n4.Exit\n\nEnter your choice: ')
    if choose =='1':
        clear_terminal()
        member.append(ask_user())
    elif choose=='2':
        clear_terminal()
        if member:
            print('Displaying all members....')
            for i in member:
