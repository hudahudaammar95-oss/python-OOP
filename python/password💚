import string
import random
letter=string.ascii_letters
number=string.digits
symbol=string.punctuation

print('welcome to the passworf Generator!')
password=int(input('Enter the total number of characters in the password: '))
letters=int(input('Enter the number of letters in the password: '))
numbers=int(input('Enter the number of the numbers in the password: '))
symbols=int(input('Enter the number of symbols in the password: '))
addition=(letters)+ (numbers) + (symbols)

if (password)!=((addition)):
    print('invalid choice')
else:
    choice=(random.choices(letter,k=letters)+
            random.choices(number,k=numbers)+
            random.choices(symbol,k=symbols) )
    random.shuffle(choice)
    paww=''.join(choice)
    print(f'your password:  {paww}')